# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider: gemini (free testing) | openai (paid)
AI_PROVIDER=gemini

# Gemini — free tier via Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI — optional; used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (optional; missing = rate limit bypassed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Maps — leave empty during free testing to avoid Maps billing
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Affiliate partner IDs / tags
KLOOK_AID=
KKDAY_AFFILIATE_ID=
AGODA_CID=

# Free tier limits
FREE_TIER_DAILY_LIMIT=5
